# Virtual environments (never commit these!)
.venv/
venv/

# Office temp files
~$*

# API keys and tool configs
utils/

# Env files — NEVER commit. Hold API keys (Gemini, Anthropic, etc.) across all projects.
# Leaves .env.example and .env.<env> (without .local) committable as templates.
.env
.env.local
.env.*.local

# OS junk
.DS_Store
Thumbs.db

.secrets/
__pycache__/

# Screenshots Briggsy drops for a session started in playbook/
playbook/temp/
# Local settings and a browser tool's scratch files in public folders: they
# can hold a user-folder path (a hook command, say) or
# screenshots, so they stay out on every machine, not only where a global git
# ignore covers them. (Other projects track their settings.local.json on
# purpose: no wildcard here.)
playbook/.claude/settings.local.json
playbook/.playwright-mcp/
projects/skills/ultramode-code-review/.claude/settings.local.json
