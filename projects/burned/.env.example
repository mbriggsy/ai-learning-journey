VITE_PARTYKIT_HOST=localhost:8787

# --- Playtest mode (DO NOT set in production) ---
#
# Phase 2 playtest-harness: enable only for local LLM-agent sessions.
# Production deployments MUST leave these unset. Wrangler reads env vars
# passed via `wrangler dev --var` flags or a playtest-only wrangler config;
# these lines are documentation, not auto-loaded by wrangler. Vite-loaded
# env vars must be prefixed `VITE_`.
#
# PLAYTEST_MODE=1
# PLAYTEST_TOKEN=replace-with-32-byte-random-hex
# PLAYTEST_GOD_ORIGINS=https://playtest.internal  # optional; LAN + localhost always allowed
