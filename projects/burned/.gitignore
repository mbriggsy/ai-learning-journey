node_modules/
dist/
coverage/
.chrome-dev-profile/

# Generated palette token artifact — source of truth is primitives.css
src/client/shared/tokens/palette.generated.ts
.partykit/
.wrangler/
.playwright-mcp/
temp/
test-results/
playwright-report/
*.local
.env*
!.env.example
!.env.production
# .env.production is checked in: it only holds VITE_PARTYKIT_HOST (public
# Worker URL that ships in every built JS bundle anyway). CI runners need
# it at build time so the prod client connects to the right WS host.

# Playtest harness session dirs — rolling retention, diagnostic artifacts.
# Logs, screenshots, events.jsonl etc. stay gitignored. Triage issue
# summaries (issues/*.md, INDEX.md) ARE tracked — institutional record
# of resolved-by-side-effect closures, surviving `pnpm playtest:purge`.
# See scripts/playtest/README.md §3.
docs/testing/playtest/runs/**
!docs/testing/playtest/runs/.gitkeep
!docs/testing/playtest/runs/*/
!docs/testing/playtest/runs/*/issues/
!docs/testing/playtest/runs/*/issues/*.md

# Playtest harness selftest stamp — per-machine timestamp, not source.
.last-selftest

# Claude Code harness runtime lock — per-session, not source.
.claude/scheduled_tasks.lock

# Dreamland S8 reference frames — fair-use internal research only.
# Fan-uploaded FX/FXX captures sourced from Archer Wiki (Fandom). Allowed:
# internal palette extraction + art-direction reference. NOT allowed: public
# distribution (which includes this public GitHub repo). The README.md at
# the directory root stays in git (URLs + attribution + fair-use posture);
# only the image files are excluded.
docs/plans/css-foundation-rebuild/dreamland-reference/images/

# Origin trailer rendered outputs — final + iteration + intermediate variants
# stay local. The repo is public; the trailer ships via Phase 7 X distribution,
# NOT via pre-distribution repo commit. The MP4s would also be large binaries
# unfit for git. Per Phase 6 doc-review Security F5.
videos/trailer/out/*.mp4
videos/trailer/out/*.mp4.new
videos/trailer/out/*.mp4.prev
videos/trailer/out/*.mp4.iterate
videos/trailer/out/test-encode.mp4
videos/trailer/out/thumbnail-candidate-*.png

# Phase 0 Unit 0.5 composite-viability spike artifacts. Regenerated by the
# Playwright capture script (`pnpm capture:htp` from videos/trailer/) and
# by ffmpeg sine-wave generation respectively. Both auto-rebuildable; the
# htp-fullpage.png is 32 MB and the spike audio is throwaway placeholder.
# Phase 3 Unit 3.1 promotes the capture script against the production URL
# and writes the production htp-fullpage.png — which IS tracked then.
public/trailer/htp-fullpage.png
public/trailer/spike/

# Decode-test panelist audio — voice memos from external testers. Panelists
# did not consent to public publication of their voice samples. Per Phase 6
# doc-review Security F4.
videos/trailer/sample-eval/final-render-qa/decode-audio/

# Archer reference stills for §2 Layer B Archer-Fidelity verdict — fair-use
# internal evaluation only (same posture as the Dreamland S8 references above).
# Not for public repo. Per Phase 6 doc-review CALL-4.
videos/trailer/sample-eval/final-render-qa/archer-reference/

# Trailer-specific files that should pass through unchanged but the directory
# above might be too broad — keep the README + sentinel signoffs + audit
# markdown committed.
!videos/trailer/out/README.md
!videos/trailer/sample-eval/final-render-qa/decode-audio/.gitkeep
!videos/trailer/sample-eval/final-render-qa/archer-reference/.gitkeep
