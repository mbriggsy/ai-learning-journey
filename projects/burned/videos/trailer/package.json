{
  "name": "burned-trailer",
  "version": "1.0.0",
  "description": "Origin trailer for BURNED — Remotion video project",
  "type": "module",
  "scripts": {
    "studio": "npx remotion studio src/index.ts",
    "render": "npx remotion render src/index.ts BurnedTrailer out/trailer-landscape.mp4 --codec h264 --crf 18",
    "render:spike": "npx remotion render src/index.ts SpikeFrameTest out/spike-frame-test.mp4 --codec h264 --crf 18",
    "render:thumbnail": "npx remotion still src/index.ts BurnedTrailer out/thumbnail.png --frame 450",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:tts": "tsx scripts/check-tts-readiness.ts",
    "preflight": "tsx scripts/generate-preflight-clip.ts",
    "preflight:phase2": "tsx scripts/preflight.ts",
    "tts": "tsx scripts/generate-dash-tts.ts",
    "tts:force": "tsx scripts/generate-dash-tts.ts --force",
    "tts:dry-run": "tsx scripts/generate-dash-tts.ts --dry-run",
    "post-process": "tsx scripts/post-process-tts.ts",
    "audit:durations": "tsx scripts/audit-durations.ts",
    "stitch:beats": "tsx scripts/stitch-beats.ts",
    "audit:stitch-positions": "tsx scripts/audit-stitch-positions.ts",
    "generate:manifest": "tsx scripts/generate-audio-manifest.ts",
    "vendor:vocab": "tsx scripts/vendor-burned-vocab.ts",
    "verify:vocab-sync": "tsx scripts/verify-vocab-sync.ts",
    "matrix": "tsx scripts/generate-tts-eval.ts",
    "scream:variant": "tsx scripts/generate-scream-variant.ts",
    "tone:clip": "tsx scripts/generate-tone-clip.ts",
    "cold-open:clip": "tsx scripts/generate-cold-open-clip.ts",
    "render:cold-open-4": "npx remotion render src/index.ts SpikeColdOpenCandidate4 out/cold-open-candidate-4.mp4 --codec h264 --crf 18",
    "render:cold-open-5": "npx remotion render src/index.ts SpikeColdOpenCandidate5 out/cold-open-candidate-5.mp4 --codec h264 --crf 18",
    "capture:htp": "tsx scripts/capture-htp-scroll-burned.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.438",
    "@remotion/fonts": "4.0.438",
    "@remotion/media": "4.0.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.438"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.1.0",
    "dotenv": "^17.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
