+// ── the reader's font: the one-frame fit law at a 24px browser default ────────────────────────
+// The chart-text gate already proves the CHARTS follow the reader's browser font up
+// (e2e/chart-text.spec.ts, its 20px-root arms); the FRAME law had never been measured under a
+// raised default at all. This re-drives the two one-frame spine arms above — REAL and the TIER
+// floor, never the tall SHOWCASE — with the browser default at 24px. Chromium-only:
+// `Page.setFontSizes` is CDP, and this harness's one project is chromium.
+//
+// Why a raised default moves this frame at all: BOTH scales are rem (tokens.css `--text-xs` …
+// `--text-hero`, `--space-1` … `--space-12`), src/**/*.css declares no literal-px font-size
+// anywhere, `html` and `:root` declare no font-size at all, and the one `body` declaration is
+// `font-size: var(--text-base)` — itself rem — so the reader's default reaches the whole scale.
+// The BUDGET does not follow it: `frameReport` measures every box against the LIVE
+// `window.innerHeight`, which no font setting grows. (`--laptop-fit-height` is the token the
+// layout is TUNED to; it never reaches this assertion.)
+//
+// ORDER — `Page.setFontSizes` is per-target emulation, and the two orders this repo has proven
+// green are "send, then navigate" (chart-text.spec.ts's `setRootFont20`, called before its first
+// `gotoSeedFinal`) and "send, then reload" (its `raiseRootFont`). So the send sits BETWEEN two
+// navigations here: a bare `/` first — it reads the baseline root px and costs no solve — then the
+// seed route, the one engine solve this arm pays for.
+//
+// Falsifiability (insight 016, this spec's docblock above): with the send removed the arm still
+// renders, still resolves, and the 16px frame FITS — so a silently-ignored, renamed or reshaped
+// CDP call would pass having measured nothing new. The root px is therefore pinned to have RISEN
+// before any geometry is read (mutant-proven: drop the send and that line reds, "root 16px → 16px").
+for (const { seed } of SPINE_SEEDS) {
+  for (const vp of [REAL, TIER] as const) {
+    const scale = vp === REAL ? { deviceScaleFactor: REAL_DPR } : {}
+    test.describe(`?seed=${seed} — the one-frame fit law at a 24px root (${vp.width}×${vp.height})`, () => {
+      test.use({ viewport: vp, ...scale })
+      test(`${seed}: everything but the doors fits one frame at a 24px root`, async ({ page, context }) => {
+        const rootPx = (): Promise<number> =>
+          page.evaluate(() => parseFloat(getComputedStyle(document.documentElement).fontSize))
+        await page.goto('/')
+        const at16 = await rootPx()
+        const cdp = await context.newCDPSession(page)
+        await cdp.send('Page.setFontSizes', { fontSizes: { standard: 24, fixed: 24 } })
+        await gotoSeedFinal(page, seed)
+        const at24 = await rootPx()
+        expect(
+          at24,
+          `Page.setFontSizes never took (root ${at16}px → ${at24}px) — this arm would measure the 16px frame`,
+        ).toBeGreaterThan(at16)
+        await assertResolvedSpine(page)
+        // RECORD the walk before asserting it: a PASSING assertion prints nothing, so this line is
+        // the standing evidence of what was actually measured at the raised root.
+        const report = await frameReport(page, true)
+        console.log(
+          `[24px-root fit] seed=${seed} ${vp.width}x${vp.height} root=${at16}→${at24}px: ` +
+            `counted=${report.counted} viewport=${vp.height} offenders=${
+              report.offenders.length === 0
+                ? 'none'
+                : report.offenders.map((o) => `${o.desc}@${o.bottom}`).join(', ')
+            }`,
+        )
+        await assertFrameFits(page, true)
+        await cdp.detach()
+      })
+    })
+  }
+}
+
