{
  "name": "top-down-racer-03",
  "version": "0.3.0",
  "description": "Top-Down Racer v03 — visual upgrade + AI generalization. Zero hand-written game code.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
